# Copia este archivo como ".env" y rellena tus propios valores.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux / macOS:         cp .env.example .env

# --- Firebase (Consola de Firebase -> Configuración del proyecto -> Tus apps) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Google reCAPTCHA v2 (https://www.google.com/recaptcha/admin) ---
# Clave del sitio: pública, va en el navegador
VITE_RECAPTCHA_SITE_KEY=
# Clave secreta: SOLO servidor. Nunca le pongas el prefijo VITE_
RECAPTCHA_SECRET_KEY=

# --- Spotify Developer (https://developer.spotify.com/dashboard) ---
VITE_SPOTIFY_CLIENT_ID=
# Client Secret: SOLO servidor. Nunca le pongas el prefijo VITE_ (se filtraría al navegador)
SPOTIFY_CLIENT_SECRET=
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback

# --- CARTO Basemaps (Opcional - https://carto.com/basemaps/apikey) ---
# Clave gratuita para las teselas oscuras nativas de CARTO Dark Matter en EchoSafe (hasta 5M req/mes).
# Si se deja vacía, el mapa usa automáticamente OpenStreetMap con modo oscuro por CSS sin marcas de agua.
VITE_CARTO_API_KEY=

# --- EmailJS (https://dashboard.emailjs.com) - Código 2FA por correo (Servidor) ---
# Si se dejan vacías en desarrollo (npm run dev), el servidor devuelve el código 2FA en modo prueba.
# En producción son obligatorias para el inicio de sesión con correo y contraseña.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# Opcional: Private Key (Access Token) de EmailJS y secreto HMAC para firmar sesiones 2FA en servidor
EMAILJS_PRIVATE_KEY=
SESSION_2FA_SECRET=
# Opcional: JSON de cuenta de servicio de Firebase Admin (en una sola línea) para operaciones privilegiadas
FIREBASE_SERVICE_ACCOUNT_KEY=

